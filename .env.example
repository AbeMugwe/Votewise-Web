# ─── Convex ────────────────────────────────────────────────────────────────
# Printed by `npx convex dev` on first run. Both are required.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Same value as NEXT_PUBLIC_CONVEX_SITE_URL. Better Auth reads this server-side.
CONVEX_SITE_URL=https://your-deployment.convex.site

# ─── Better Auth ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google sign-in (optional) ─────────────────────────────────────────────
# Leave blank to disable the Google button; email + password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
